306695.2","chraccver":"NC_018930.2","chrstart":676088,"chrstop":683091}]},"2289":{"uid":"2289","name":"FKBP5","description":"FKBP prolyl isomerase 5","status":"","currentid":"","chromosome":"6","geneticsource":"genomic","maplocation":"6p21.31","otheraliases":"AIG6, FKBP51, FKBP54, P54, PPIase, Ptg-10","otherdesignations":"peptidyl-prolyl cis-trans isomerase FKBP5|51 kDa FK506-binding protein|51 kDa FKBP|54 kDa progesterone receptor-associated immunophilin|FF1 antigen|FK506 binding protein 5|FKBP-51|HSP90-binding immunophilin|PPIase FKBP5|T-cell FK506-binding protein|androgen-regulated protein 6|peptidylprolyl cis-trans isomerase|rotamase","nomenclaturesymbol":"FKBP5","nomenclaturename":"FKBP prolyl isomerase 5","nomenclaturestatus":"Official","mim":["602623"],"genomicinfo":[{"chrloc":"6","chraccver":"NC_000006.12","chrstart":35728582,"chrstop":35573589,"exoncount":13}],"geneweight":18652,"summary":"The protein encoded by this gene is a member of the immunophilin protein family, which play a role in immunoregulation and basic cellular processes involving protein folding and trafficking. This encoded protein is a cis-trans prolyl isomerase that binds to the immunosuppressants FK506 and rapamycin. It is thought to mediate calcineurin inhibition. It also interacts functionally with mature hetero-oligomeric progesterone receptor complexes along with the 90 kDa heat shock protein and P23 protein. This gene has been found to have multiple polyadenylation sites. Alternative splicing results in multiple transcript variants.[provided by RefSeq, Mar 2009]","chrsort":"06","chrstart":35573589,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000006.12","chrstart":35728582,"chrstop":35573589},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060930.1","chrstart":35548946,"chrstop":35396663},{"annotationrelease":"RS_2