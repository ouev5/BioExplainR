{"header":{"type":"esummary","version":"0.3"},"result":{"uids":["200186513"],"200186513":{"uid":"200186513","accession":"GSE186513","gds":"","title":"Profiling of Polyadenylated RNAs after Brg1/Smarca4 knock-down in murine bone marrow-derived macrophages after LPS or LPS plus Dex stimulation [RNA-seq]","summary":"We performed Brg1 (Smarac4) knock-down by siRNA in murine primary bone marrow-derived macrophages and profiled the effect on gene expression by RNAseq after lipopolysaccharide (LPS) or LPS plus dexamethasone (Dex) treatment. Brg1 knock-down cells are compared to cells treated with a control siRNA. We analysed the requirement of Brg1/Smarca4 for the expression of inflammatory and glucocorticoid receptor target genes.","gpl":"21103","gse":"186513","taxon":"Mus musculus","entrytype":"GSE","gdstype":"Expression profiling by high throughput sequencing","ptechtype":"","valtype":"","ssinfo":"","subsetinfo":"","pdat":"2023/10/31","suppfile":"TXT","samples":[{"accession":"GSM5655000","title":"RNA-seq_BMDM_Brg1Si_DexLPS_rep3"},{"accession":"GSM5654997","title":"RNA-seq_BMDM_Brg1Si_LPS_rep3"},{"accession":"GSM5654983","title":"RNA-seq_BMDM_ctrlSi_veh_rep2"},{"accession":"GSM5654986","title":"RNA-seq_BMDM_ctrlSi_LPS_rep2"},{"accession":"GSM5654989","title":"RNA-seq_BMDM_ctrlSi_DexLPS_rep2"},{"accession":"GSM5654982","title":"RNA-seq_BMDM_ctrlSi_veh_rep1"},{"accession":"GSM5654985","title":"RNA-seq_BMDM_ctrlSi_LPS_rep1"},{"accession":"GSM5654991","title":"RNA-seq_BMDM_ctrlSi_DexLPS_rep4"},{"accession":"GSM5654988","title":"RNA-seq_BMDM_ctrlSi_DexLPS_rep1"},{"accession":"GSM5654994","title":"RNA-seq_BMDM_Brg1Si_veh_rep3"},{"accession":"GSM5654987","title":"RNA-seq_BMDM_ctrlSi_LPS_rep3"},{"accession":"GSM5654990","title":"RNA-seq_BMDM_ctrlSi_DexLPS_rep3"},{"accession":"GSM5654993","title":"RNA-seq_BMDM_Brg1Si_veh_rep2"},{"accession":"GSM5654996","title":"RNA-seq_BMDM_Brg1Si_LPS_rep2"},{"accession":"GSM5654984","title":"RNA-seq_BMDM_ctrlSi_veh_rep3"},{"accession":"GSM56549