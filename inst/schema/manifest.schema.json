{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioexplainr.local/schema/manifest-1.0.json",
  "title": "BioExplainR runtime manifest",
  "type": "object",
  "required": ["manifest_version", "run_id", "schema_version", "serialization_version", "status"],
  "properties": {
    "manifest_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string"}, "context_id": {"type": ["string", "null"]},
    "facts_hash": {"type": ["string", "null"]}, "payload_hash": {"type": ["string", "null"]},
    "request_hash": {"type": ["string", "null"]}, "response_hash": {"type": ["string", "null"]},
    "schema_version": {"type": "string"}, "serialization_version": {"type": "string"},
    "status": {"enum": ["not_run", "executed", "failed", "missing", "replayed"]}
  }, "additionalProperties": true
}
